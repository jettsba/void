<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Без этой строки macOS не покажет запрос доступа к микрофону и молча
         откажет getUserMedia. Запись экрана своей строки не требует:
         демонстрацию WebKit ведёт через системный выбор экрана. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>void uses the microphone for voice calls.</string>
    <!-- Камера в звонке и сканер QR в друзьях (js/camera.js, js/friends/ui.js).
         Без строки getUserMedia({video}) отказывает молча, без запроса. -->
    <key>NSCameraUsageDescription</key>
    <string>void uses the camera for video in calls and to scan friend QR codes.</string>
    <!-- Звук демонстрации: Core Audio process tap пишет системный звук (кроме
         самого void), и без этой строки система не покажет запрос «запись звука
         системы» — создание тапа просто вернёт ошибку. См.
         src/screen_audio_mac.rs. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>void captures system audio so your screen share has sound.</string>
    <!-- Языки приложения. Свои пункты меню void переводит сам (lib.rs
         mac_app_menu), а то, что AppKit дописывает в меню сам («Эмодзи и
         символы», «Диктовка», пункты окна, системный запрос микрофона),
         он берёт на языке системы, только если тот есть в этом списке. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ru</string>
    </array>
</dict>
</plist>

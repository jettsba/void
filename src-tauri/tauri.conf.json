{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Void",
  "version": "0.10.16",
  "identifier": "space.void-room.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Void",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Эфемерные P2P голосовые комнаты",
    "longDescription": "Без аккаунтов, без БД, без следов. Поговорил — исчезло.",
    "copyright": "© 2026 Void",
    "category": "SocialNetworking",
    "publisher": "Void",
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}

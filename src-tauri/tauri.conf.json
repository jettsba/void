{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Void",
  "version": "0.10.46",
  "identifier": "space.void-room.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Эфемерные P2P голосовые комнаты",
    "longDescription": "Без аккаунтов, без БД, без следов. Поговорил — исчезло.",
    "copyright": "© 2026 Void",
    "category": "SocialNetworking",
    "publisher": "Void",
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}

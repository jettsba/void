# ============================================================================
#                          void-room :: env-template
# ============================================================================
# Скопируй в .env (`cp .env.example .env`) и заполни. Всё, кроме TURN_*,
# опционально — проект работает с дефолтами.
#
# Файл .env читается docker-compose автоматически. Если меняешь значения —
# `docker compose up -d` (без --build) подхватит без пересборки образа.
# ============================================================================

# --- ADMINSTATS -------------------------------------------------------------
# Пароль для GET /adminstats. Если не задан — endpoint вернёт 503 «disabled»,
# панель останется недоступной даже без файрвола.
ADMIN_STATS_PASSWORD=

# --- LOGGING ----------------------------------------------------------------
# error | warn | info | debug. Дефолт info. На проде info — нормальная плотность,
# debug — когда отлаживаешь баг и нужно видеть все коннекты/дисконнекты.
LOG_LEVEL=info

# --- ORIGINS ----------------------------------------------------------------
# Whitelist Origin'ов для WS-handshake. Через запятую. Меняешь домен на VPS —
# меняешь здесь, в код не лезешь. Пусто = прод-дефолты из lib/security.js.
ALLOWED_ORIGINS=

# --- ROOM LIMITS ------------------------------------------------------------
# Максимум юзеров в одной комнате. 5 — потолок mesh-топологии.
MAX_ROOM_USERS=5

# --- BUG REPORTS (Yandex SMTP) ----------------------------------------------
# Багрепорт-форма из настроек шлёт письмо через smtp.yandex.ru:465.
# Если USER или PASS пусты — POST /api/report-bug возвращает 503.
# BUG_SMTP_PASS — app-password от Яндекс.Почты, НЕ пароль аккаунта.
# BUG_SMTP_TO — куда слать (опционально, дефолт = BUG_SMTP_USER).
BUG_SMTP_USER=
BUG_SMTP_PASS=
BUG_SMTP_TO=

# --- TURN (для symmetric NAT / CG-NAT юзеров) -------------------------------
# Если оставить пустыми — TURN отключён, клиент работает только со STUN
# (как раньше). Соединения через симметричный NAT не поднимутся, но проект
# запустится без TURN-инфры (dev / маленький beta-тест).
#
# Для прод-настройки на реальной аудитории — обязательно заполнить.
# Без TURN ~10-20% пар обламываются (typical CG-NAT / мобильные сети).
#
# Подъём TURN: `docker compose --profile turn up -d --build`.
# Без --profile turn — coturn-сервис не стартует.
#
# TURN_HOST — публичное hostname или IP VPS, как его видят клиенты.
#             Рекомендуется hostname (turn.your-domain.com через A-запись).
# TURN_EXTERNAL_IP — публичный IP VPS. coturn анонсирует его в ICE-кандидатах.
#             Обычно совпадает с тем, что для сайта.
# TURN_SECRET — общий секрет между Node-приложением и coturn. Случайная
#             строка ≥ 32 символов. Генерация: `openssl rand -base64 48`.
# TURN_REALM — обычно равен домену. Только для coturn-логов.
TURN_HOST=
TURN_EXTERNAL_IP=
TURN_SECRET=
TURN_REALM=

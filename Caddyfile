# ============================================================================
# Caddyfile — reverse-proxy с автоматическим HTTPS для void
# ============================================================================
#
# Этот файл нужен ТОЛЬКО на боевом сервере (VPS), на локалке его трогать не надо.
# На локалке ты запускаешь node как обычно, открываешь http://localhost:3000 — всё работает.
#
# ----------------------------------------------------------------------------
# КАК ИСПОЛЬЗОВАТЬ НА ПРОДЕ (пошагово, с нуля):
# ----------------------------------------------------------------------------
#
# 1. Купи домен (например, void.ru / voidchat.app — что нравится).
#
# 2. В админке регистратора домена создай A-запись, указывающую на IP твоего VPS.
#    Подожди 5-30 минут пока DNS обновится. Проверить можно так:
#       ping void-room.space   (должен резолвиться в IP твоего сервера)
#
# 3. На VPS установи Caddy. Одна команда (для Ubuntu/Debian):
#       sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https curl
#       curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#       curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#       sudo apt update && sudo apt install caddy
#    (актуальная инструкция: https://caddyserver.com/docs/install)
#
# 4. На VPS запусти свой node-сервер как обычно (он должен слушать localhost:3000):
#       node server.js
#    (в проде лучше через pm2 / systemd, но для MVP сойдёт и просто node)
#
# 5. Открой /etc/caddy/Caddyfile на сервере и положи туда содержимое ЭТОГО файла,
#    заменив домен ниже при необходимости (сейчас: void-room.space).
#
# 6. Перезагрузи Caddy:
#       sudo systemctl reload caddy
#
# Всё. Caddy автоматически:
#   - сходит за бесплатным TLS-сертификатом от Let's Encrypt
#   - будет его продлевать раз в 60 дней без твоего участия
#   - будет проксировать HTTPS → твой node на localhost:3000
#   - корректно проксирует WebSocket (никакой ручной настройки upgrade-headers не нужно,
#     в отличие от nginx)
#
# Откроешь https://void-room.space — всё работает, микрофон разрешён, wss поднимается.
# ============================================================================

# ---- www → apex редирект ----------------------------------------------------
# Каноническая версия лендинга — apex (без www.). Отдельный блок делает 301
# на apex с сохранением пути и query — устраняет дубль контента в индексе Google
# (раньше оба домена отдавали идентичный контент с разных URL → размытый PageRank).
www.void-room.space {
    redir https://void-room.space{uri} 301
}

# ---- Лендинг (основной домен) -----------------------------------------------
# script-src БЕЗ 'unsafe-inline': inline-скрипты с лендинга удалены (язык
# роутится server-side в server.js). Можно вернуть 'unsafe-inline' если
# понадобится новый inline-блок, но лучше выносить в .js файл.
#
# Сжатие: zstd для современных браузеров (Chrome 123+, FF 126+, Safari 17.4+),
# gzip как универсальный fallback. brotli убран — он требует отдельного
# модуля http.encoders.br (не входит в стандартный apt-пакет caddy на VPS,
# его подтягивает только кастомная сборка через xcaddy). zstd+gzip покрывают
# 99% UA. Caddy выбирает формат по Accept-Encoding клиента автоматически.
void-room.space {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "microphone=(), camera=(), geolocation=(), display-capture=(), interest-cohort=()"
        Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        -Server
    }

    # Длинный immutable cache для статики. Безопасно потому что все ссылки на
    # CSS/JS/изображения с лендинга и app идут через cache-buster ?v=N: при
    # правке файла бампим N → URL меняется → браузер скачивает новый ответ.
    # Без bumpa старая версия может висеть в кэше юзера до года — поэтому в
    # memory есть правило обязательного bump'а при правке landing/* и public/*.
    @static path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.woff *.woff2 *.ttf *.otf *.mp3 *.ogg *.webmanifest
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Скрытая страница: подкреплённый HTTP-заголовком noindex для путей
    # /the-void-egg и /en/the-void-egg. Дублирует <meta name="robots"> внутри
    # HTML — пояс с подтяжками. Поисковики не должны её индексировать, даже
    # если внезапно найдут (в sitemap её нет, в robots.txt не упомянута).
    @egg path /the-void-egg /en/the-void-egg
    header @egg X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

    reverse_proxy localhost:3000
}

# ---- Приложение (поддомен app) -----------------------------------------------
# Строгий CSP: script-src без 'unsafe-inline'. В коде приложения нет inline-скриптов
# (UI scale bootstrap вынесен в /ui-scale-bootstrap.js, чтобы не требовать
# unsafe-inline и при этом отрабатывать ДО загрузки CSS на больших мониторах).
# style-src 'unsafe-inline' оставлен: JS динамически ставит el.style.x для анимаций.
# connect-src содержит wss:// для WebSocket-сигналинга.
app.void-room.space {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "microphone=(self), camera=(self), geolocation=(), display-capture=(self), interest-cohort=()"
        Content-Security-Policy   "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://app.void-room.space; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        -Server
    }

    # Длинный immutable cache для статики (то же обоснование что на лендинге —
    # все ссылки версионированы через ?v=N, см. memory rule).
    @static path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico *.woff *.woff2 *.ttf *.otf *.mp3 *.ogg *.webmanifest
    header @static Cache-Control "public, max-age=31536000, immutable"

    # /adminstats защищён timing-safe сравнением пароля (lib/admin-stats.js).
    reverse_proxy localhost:3000
}
